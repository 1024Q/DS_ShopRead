{
  "name": "pdd-local-shop-manager",
  "version": "2.0.0",
  "private": true,
  "description": "Next.js and Python multi-shop browser manager",
  "scripts": {
    "dev": "node server.cjs --dev",
    "build": "next build --webpack",
    "start": "node server.cjs",
    "test": ".venv\\Scripts\\python.exe -m unittest discover -s backend/tests",
    "lint": "npm run lint:web && npm run lint:python",
    "lint:web": "eslint app lib tests scripts server.cjs",
    "lint:python": "node scripts/check-python.cjs --lint",
    "test:web": "node scripts/test-web.cjs",
    "test:python": "node scripts/check-python.cjs",
    "test:all": "npm run test:web && npm run test:python",
    "test:browser": "playwright test tests/account-access.spec.cjs --workers=1",
    "format:files": "prettier --write",
    "format:web": "prettier --write \"{app,lib,scripts,tests}/**/*.{js,cjs,mjs,css}\" \"*.cjs\" \"*.mjs\"",
    "format:check:web": "prettier --check \"{app,lib,scripts,tests}/**/*.{js,cjs,mjs,css}\" \"*.cjs\" \"*.mjs\"",
    "format:python": "node scripts/check-python.cjs --format",
    "format:check:python": "node scripts/check-python.cjs --format-check",
    "format:check": "npm run format:check:web && npm run format:check:python"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "antd": "6.6.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
